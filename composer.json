{
    "name": "thebigcrafter/kygek-last-position",
    "description": "PocketMine-MP plugin for returning players to their previous teleport position",
    "license": "GPL-3.0-only",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/Hydrogen",
            "no-api": true
        }
    ],
    "require": {
        "thebigcrafter/hydrogen": "^1.1.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.49.1"
    },
    "autoload-dev": {
        "psr-4": {
            "thebigcrafter\\Hydrogen\\": "tools/stubs/Hydrogen/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon.dist"
    }
}
